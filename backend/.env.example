# MongoDB Connection String (get from MongoDB Atlas)
# Format: mongodb+srv://username:password@cluster.mongodb.net/databasename
MONGODB_URI=mongodb+srv://admin:YOUR_PASSWORD@portfolio-db.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# Admin Panel Credentials
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=your-secure-password

# Environment
NODE_ENV=production

# Server Port (for local development)
PORT=5000
